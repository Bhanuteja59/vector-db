# ==========================================
# AegisVector DB - Environment Template (.env.example)
# Copy this file to .env and adjust your settings:
#   cp .env.example .env
# ==========================================

# Server Settings
VECTORDB_APP_NAME="AegisVector DB"
VECTORDB_VERSION="1.0.0"
VECTORDB_HOST=0.0.0.0
VECTORDB_PORT=8000
VECTORDB_LOG_LEVEL=INFO

# Storage & Durability
VECTORDB_DATA_DIR=./data
VECTORDB_AUTO_PERSIST=true

# Security & Authentication
# Leave empty for unauthenticated dev mode, or set a secure random key
VECTORDB_API_KEY=

# Default Configurations
VECTORDB_DEFAULT_INDEX_TYPE=hnsw
VECTORDB_DEFAULT_METRIC=cosine

# Network & CORS Settings
VECTORDB_CORS_ORIGINS=*
